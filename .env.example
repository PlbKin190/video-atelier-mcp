# video-atelier-mcp — configuration
#
# NOTHING HERE IS REQUIRED. Importing, cutting, captioning, compositing, rendering
# and exporting all work with no key at all. Only the optional Azure generation
# backend needs credentials.
#
# Every variable below is read by the code, and defaults are shown after the "=" — except the
# model-cache paths, which the SAM2 runner forces; see the SAM2 section.

# ---------------------------------------------------------------- work directory
# Where rushes, compositions, render jobs and outputs live. Inside the container
# this is /work, mounted from ./work on the host. Everything the server reads or
# writes must sit under it.
ATELIER_WORK_DIR=/work

# ---------------------------------------------------------------------- ffmpeg
# Both binaries ship in the Docker image; set these only outside the container.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ------------------------------------------------------------------- captions
# captions_transcribe shells out to the Whisper CLI. It is NOT in the base image
# (it would pull in torch). captions_write_srt + captions_burn need nothing.
WHISPER_PATH=whisper

# ----------------------------------------------------------- SAM2 (sam2 profile)
# Only used by the `sam2` Docker profile. The base image has neither torch nor a
# model, and the sam2 tools return a clear error there instead of a stack trace.
ATELIER_PYTHON=python3
# Path to the bundled runner; override only to point at your own script.
ATELIER_SAM2_RUNNER=
# cpu, cuda or mps.
ATELIER_SAM2_DEVICE=cpu
# The SAM2 checkpoint cache (2-4 GB, downloaded on first use) is NOT configurable: the runner
# forces HF_HOME, HF_HUB_CACHE, HUGGINGFACE_HUB_CACHE and TORCH_HOME to $ATELIER_WORK_DIR/models
# so the download always lands inside the mounted volume (python/sam2_runner.py, setup).
# Setting them here has no effect; move ATELIER_WORK_DIR instead.

# ------------------------------------------- generation backend (optional, paid)
# The generation backend is chosen per call: generate_shot takes backend="local"
# (the default, no key, reuses footage you already have) or "azure-sora".
#
# END OF LIFE, dated: OpenAI retires sora-2 from its API on 24 September 2026, and
# the Azure sora-2 version 2025-12-08 stops on 15 October 2026. The atelier does
# not depend on it — editing, screen replacement and rendering never call it.
AZURE_SORA_ENDPOINT=
AZURE_SORA_API_KEY=
AZURE_SORA_DEPLOYMENT=
