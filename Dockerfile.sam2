# Image de base produite par docker compose build atelier.
ARG ATELIER_BASE_IMAGE=video-atelier-mcp:0.1.0
FROM ${ATELIER_BASE_IMAGE}
USER root
# Le paquet sam2 du Studio est patché ; sa source n'est pas identifiable
# dans le code lu (studio_platform/packs/dev/tools/screen_composite_sam2.py:16-17).
# Installer le dépôt officiel de Meta, puis vérifier sa compatibilité avec
# le portage : ceci n'est PAS une reproduction validée de la version patchée.
# Fournir les URL officielles vérifiées via les arguments de build : elles
# ne figurent pas dans les sources mesurées. Échec explicite si absentes.
ARG SAM2_OFFICIAL_GIT_URL
ARG TORCH_CPU_INDEX_URL
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/sam2
ENV PATH="/opt/sam2/bin:${PATH}"
# Ne pas imposer torch==2.2.2 du Studio au sam2 officiel non identifié.
# Résolution non verrouillée : versions à figer après validation du profil.
RUN test -n "${SAM2_OFFICIAL_GIT_URL}" && test -n "${TORCH_CPU_INDEX_URL}" \
    && pip install --no-cache-dir torch torchvision --index-url "${TORCH_CPU_INDEX_URL}" \
    && pip install --no-cache-dir opencv-python-headless 'numpy<2' huggingface_hub \
    && pip install --no-cache-dir "git+${SAM2_OFFICIAL_GIT_URL}" \
    && pip check
# Aucun téléchargement de poids pendant le build. Le futur runner doit
# déclencher le chargement au premier usage et utiliser ce cache persistant.
ENV HF_HOME=/work/models ATELIER_SAM2_DEVICE=cpu
RUN mkdir -p /work/models && chown -R node:node /work
USER node
WORKDIR /app
VOLUME ["/work"]
ENTRYPOINT ["node", "dist/index.js"]
